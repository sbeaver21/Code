# Environment Variables Template
# Copy this file to .env and fill in your actual values
# Add .env to .gitignore to prevent committing sensitive data

# vCenter Server Credentials (Sensitive)
export VSPHERE_SERVER="your-vcenter-server.example.com"
export VSPHERE_USERNAME="your-service-account@domain.com"
export VSPHERE_PASSWORD="your-secure-password"

# Windows VM Credentials (Sensitive)
export WIN_ADMIN_USERNAME="administrator"
export WIN_ADMIN_PASSWORD="your-secure-windows-password"

# Optional: Alternative to hardcoded values in variables.pkrvars.hcl
# These will override the default values when using -var-file="variables.pkrvars.hcl"

# Example usage:
# packer build -var-file="variables.pkrvars.hcl" doe-windows-2019-improved.pkr.hcl