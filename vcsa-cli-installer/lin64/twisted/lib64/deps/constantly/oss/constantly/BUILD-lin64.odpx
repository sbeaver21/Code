<?xml version="1.0" ?>
<disclosure xmlns="http://osstp.eng.vmware.com" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://osstp.eng.vmware.com buildodpx.xsd">
	<name>
		constantly
	</name>
	<version>
		15.1.0
	</version>
	<category>
		Cayman
	</category>
	<components>
		<component branch="master" changenumber="2f5b0602f5768b56cbc542935df9884549dd906c">
			cayman
		</component>
		<component branch="vmware-python-3.5-latest-openssl-1.0.2" changenumber="faac685d9d86df227c9e259cefed10ed723267ee">
			cayman_python
		</component>
		<component branch="vcsa-cli-installer" changenumber="d711463d4af4f7ad970c70b2270ab81b3d17ba50">
			cayman_setuptools
		</component>
		<component branch="six-latest-python-3.5" changenumber="6df53a72d7152b63107d1429f0092b8cf536332b">
			cayman_six
		</component>
	</components>
	<build suffix="lin64">
		<target>
			lin64
		</target>
		<files>
			<file>
				constantly-15.1.0.tar.gz
			</file>
			<file>
				vtoolchain.cmake
			</file>
		</files>
		<process>
			<execute>
				tar zxvf constantly-15.1.0.tar.gz
			</execute>
			<execute>
				cd constantly-15.1.0
			</execute>
			<execute>
				mkdir -p /build/mts/release/bora-6919268/publish/lin64/lib/python3.5/site-packages
			</execute>
			<execute>
				mkdir -p /tmp/build/release/lin64/constantly/build/constantly-15.1.0
			</execute>
			<execute>
				cp -r /tmp/constantly/src/* /tmp/build/release/lin64/constantly/build/constantly-15.1.0
			</execute>
			<execute>
				cd /tmp/build/release/lin64/constantly/build/constantly-15.1.0
			</execute>
			<execute>
				export GCC=/build/toolchain/lin32/gcc-4.4.3/bin/x86_64-linux5.0-gcc
			</execute>
			<execute>
				export CC=/build/toolchain/lin32/gcc-4.4.3/bin/x86_64-linux5.0-gcc
			</execute>
			<execute>
				export PYTHONPATH=/tmp/compcache/cayman_setuptools/ob-6883993/linux64/lin64/lib/python3.5/site-packages:/tmp/compcache/cayman_six/ob-5693504/linux64/noarch/lib/python3.5/site-packages:/build/mts/release/bora-6919268/publish/lin64/lib/python3.5/site-packages
			</execute>
			<execute>
				export CXX=/build/toolchain/lin32/gcc-4.4.3/bin/x86_64-linux5.0-g++
			</execute>
			<execute>
				export TMPDIR=/build/mts/release/bora-6919268/tmp
			</execute>
			<execute>
				export PATH=/tmp/build/release/lin64/constantly/deps/bin:
			</execute>
			<execute>
				export COMPILER_DIR=/build/toolchain/lin32/gcc-4.4.3
			</execute>
			<execute>
				export LD_LIBRARY_PATH=/tmp/build/release/lin64/constantly/deps/lib:/tmp/build/release/lin64/constantly/build/tmp/lib:
			</execute>
			<execute>
				export GCC_DIR=/build/toolchain/lin32/gcc-4.4.3
			</execute>
			<execute>
				/tmp/compcache/cayman_python/ob-5743155/linux64/lin64/bin/python3 setup.py build
			</execute>
			<execute>
				/tmp/compcache/cayman_python/ob-5743155/linux64/lin64/bin/python3 setup.py install --no-compile --skip-build '--prefix=/build/mts/release/bora-6919268/publish/lin64'
			</execute>
		</process>
		<deliveries>
			<delivery dir="/tmp/build/release/constantly/staging/lin64">
				constantly.tgz
			</delivery>
		</deliveries>
		<output>
			lin64
		</output>
	</build>
</disclosure>
