			</execute>
			<execute>
				cd c:\build\release\win64_vc140\python-attrs\build
			</execute>
			<execute>
				set LIB=;C:\Program Files (x86)\Microsoft Visual Studio 14.0\VC\lib\amd64;C:\Program Files (x86)\Microsoft Visual Studio 14.0\VC\atlmfc\lib\amd64;C:\Program Files (x86)\Windows Kits\10\lib\10.0.14393.0\ucrt\x64;C:\Program Files (x86)\Windows Kits\10\lib\10.0.14393.0\um\x64;c:\build\release\win64_vc140\python-attrs\build
			</execute>
			<execute>
				set CC=C:\Program Files (x86)\Microsoft Visual Studio 14.0\VC\bin\amd64\cl.exe
			</execute>
			<execute>
				set PYTHONPATH=d:/build/ob/bora-5829946/compcache/cayman_setuptools/ob-5820119/windows-2016-vs2015-U3\win64_vc140\Lib\site-packages;d:/build/ob/bora-5829946/compcache/cayman_six/ob-5693504/linux64\noarch\lib\python3.5\site-packages;d:/build/ob/bora-5829946/publish\win64_vc140\Lib\site-packages
			</execute>
			<execute>
				set LIBPATH=;C:\Program Files (x86)\Microsoft Visual Studio 14.0\VC\lib\amd64;C:\Program Files (x86)\Microsoft Visual Studio 14.0\VC\atlmfc\lib\amd64;C:\Program Files (x86)\Windows Kits\10\lib\10.0.14393.0\ucrt\x64;C:\Program Files (x86)\Windows Kits\10\lib\10.0.14393.0\um\x64;c:\build\release\win64_vc140\python-attrs\build
			</execute>
			<execute>
				set PATH=C:\Program Files (x86)\Microsoft Visual Studio 14.0\VC\bin\amd64;;C:\Program Files (x86)\MSBuild\14.0\bin;C:\Program Files (x86)\Windows Kits\10\bin\x64;C:\Program Files (x86)\Windows Kits\10\bin\x86;C:\Windows\system32;C:\Windows
			</execute>
			<execute>
