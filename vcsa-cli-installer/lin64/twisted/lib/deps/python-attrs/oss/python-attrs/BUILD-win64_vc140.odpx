			</file>
			<file>
				vtoolchain.cmake
			</file>
		</files>
		<process>
			<execute>
				tar zxvf python-attrs-17.2.0.tar.gz
			</execute>
			<execute>
				cd python-attrs-17.2.0
			</execute>
			<execute>
				cd .
			</execute>
			<execute>
				set TMP=d:/build/ob/bora-5829946\tmp
			</execute>
			<execute>
				set PATH=C:\Windows\system32;C:\Windows
			</execute>
			<execute>
				set SystemDrive=C:
			</execute>
			<execute>
				set TEMP=d:/build/ob/bora-5829946\tmp
			</execute>
			<execute>
				set SystemRoot=C:\Windows
			</execute>
			<execute>
				reg.exe query HKLM\SOFTWARE\Microsoft\Windows Kits\Installed Roots /v KitsRoot10
			</execute>
			<execute>
				reg.exe query HKLM\SOFTWARE\Microsoft\Windows Kits\Installed Roots /v KitsRoot10
			</execute>
			<execute>
				reg.exe query HKLM\SOFTWARE\Microsoft\VisualStudio\SxS\VS7 /v 14.0
			</execute>
			<execute>
				reg.exe query HKLM\SOFTWARE\Microsoft\MSBuild\ToolsVersions\14.0 /v MSBuildToolsPath
			</execute>
			<execute>
				mkdir c:\build\release\win64_vc140\python-attrs\build
			</execute>
			<execute>
