			<execute>
				d:/build/ob/bora-5829946/compcache/cayman_python/ob-5743155/windows2012r2-vs2015U1\win64_vc140\python.exe setup.py install --no-compile --skip-build --single-version-externally-managed --root=d:\build\ob\bora-5829946\publish\win64_vc140 --prefix=d:\build\ob\bora-5829946\publish\win64_vc140\..\..\..\..\..
