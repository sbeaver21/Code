<?xml version="1.0" ?>
<disclosure xmlns="http://osstp.eng.vmware.com" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://osstp.eng.vmware.com buildodpx.xsd">
	<name>
		constantly
	</name>
	<version>
		15.1.0
	</version>
	<category>
		Cayman
	</category>
	<components>
		<component branch="master" changenumber="2f5b0602f5768b56cbc542935df9884549dd906c">
			cayman
		</component>
		<component branch="vmware-python-3.5-latest-openssl-1.0.2" changenumber="faac685d9d86df227c9e259cefed10ed723267ee">
			cayman_python
		</component>
		<component branch="vcsa-cli-installer" changenumber="d711463d4af4f7ad970c70b2270ab81b3d17ba50">
			cayman_setuptools
		</component>
		<component branch="six-latest-python-3.5" changenumber="6df53a72d7152b63107d1429f0092b8cf536332b">
			cayman_six
		</component>
	</components>
	<build suffix="mac64">
		<target>
			apple_mac64
		</target>
		<files>
			<file>
				constantly-15.1.0.tar.gz
			</file>
			<file>
				vtoolchain.cmake
			</file>
		</files>
		<process>
			<execute>
				tar zxvf constantly-15.1.0.tar.gz
			</execute>
			<execute>
				cd constantly-15.1.0
			</execute>
			<execute>
				mkdir -p /build/mts/release/bora-6919268/publish/apple_mac64/lib/python3.5/site-packages
			</execute>
			<execute>
				mkdir -p /tmp/build/release/apple_mac64/constantly/build/constantly-15.1.0
			</execute>
			<execute>
				cp -r /tmp/constantly/src/* /tmp/build/release/apple_mac64/constantly/build/constantly-15.1.0
			</execute>
			<execute>
				cd /tmp/build/release/apple_mac64/constantly/build/constantly-15.1.0
			</execute>
			<execute>
				export OTOOL=/build/toolchain/mac32/xcode-7.3/Xcode.app/Contents/Developer/Toolchains/XcodeDefault.xctoolchain/usr/bin/otool
			</execute>
			<execute>
				export DSYMUTIL=/build/toolchain/mac32/xcode-7.3/Xcode.app/Contents/Developer/Toolchains/XcodeDefault.xctoolchain/usr/bin/dsymutil
			</execute>
			<execute>
				export LDFLAGS=-Wl,-headerpad_max_install_names -arch x86_64 -isysroot /build/toolchain/mac32/xcode-7.3/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX10.11.sdk -mmacosx-version-min=10.9
			</execute>
			<execute>
				export CC=/build/toolchain/mac32/xcode-7.3/Xcode.app/Contents/Developer/Toolchains/XcodeDefault.xctoolchain/usr/bin/clang
			</execute>
			<execute>
				export PYTHONPATH=/tmp/compcache/cayman_setuptools/ob-6883993/macosx-elcapitan/apple_mac64/lib/python3.5/site-packages:/tmp/compcache/cayman_six/ob-5693504/linux64/noarch/lib/python3.5/site-packages:/build/mts/release/bora-6919268/publish/apple_mac64/lib/python3.5/site-packages
			</execute>
			<execute>
				export MAKE=/build/toolchain/mac32/make-3.82/bin/make
			</execute>
			<execute>
				export LDSHARED=/build/toolchain/mac32/xcode-7.3/Xcode.app/Contents/Developer/Toolchains/XcodeDefault.xctoolchain/usr/bin/clang -Wl,-headerpad_max_install_names -arch x86_64 -isysroot /build/toolchain/mac32/xcode-7.3/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX10.11.sdk -mmacosx-version-min=10.9 -bundle -undefined dynamic_lookup
			</execute>
			<execute>
				export NMEDIT=/build/toolchain/mac32/xcode-7.3/Xcode.app/Contents/Developer/Toolchains/XcodeDefault.xctoolchain/usr/bin/nmedit
			</execute>
			<execute>
				export LIPO=/build/toolchain/mac32/xcode-7.3/Xcode.app/Contents/Developer/Toolchains/XcodeDefault.xctoolchain/usr/bin/lipo
			</execute>
			<execute>
				export DEVELOPER_DIR=/build/toolchain/mac32/xcode-7.3/Xcode.app/Contents/Developer
			</execute>
			<execute>
				export CXX=/build/toolchain/mac32/xcode-7.3/Xcode.app/Contents/Developer/Toolchains/XcodeDefault.xctoolchain/usr/bin/clang++
			</execute>
			<execute>
				export RANLIB=/build/toolchain/mac32/xcode-7.3/Xcode.app/Contents/Developer/Toolchains/XcodeDefault.xctoolchain/usr/bin/ranlib
			</execute>
			<execute>
				export CFLAGS=-g -fPIC -pipe -Wall -arch x86_64 -isysroot /build/toolchain/mac32/xcode-7.3/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX10.11.sdk -mmacosx-version-min=10.9
			</execute>
			<execute>
				export STRIP=/build/toolchain/mac32/xcode-7.3/Xcode.app/Contents/Developer/Toolchains/XcodeDefault.xctoolchain/usr/bin/strip
			</execute>
			<execute>
				export PATH=/tmp/build/release/apple_mac64/constantly/deps/bin:
			</execute>
			<execute>
				export TMPDIR=/build/mts/release/bora-6919268/tmp
			</execute>
			<execute>
				export NM=/build/toolchain/mac32/xcode-7.3/Xcode.app/Contents/Developer/Toolchains/XcodeDefault.xctoolchain/usr/bin/nm
			</execute>
			<execute>
				/build/toolchain/mac32/python-3.5.2-openssl1.0.2k/bin/python3 setup.py version
			</execute>
			<execute>
				/build/toolchain/mac32/python-3.5.2-openssl1.0.2k/bin/python3 setup.py build
			</execute>
			<execute>
				/build/toolchain/mac32/python-3.5.2-openssl1.0.2k/bin/python3 setup.py install --no-compile --skip-build '--prefix=/build/mts/release/bora-6919268/publish/apple_mac64'
			</execute>
		</process>
		<deliveries>
			<delivery dir="/tmp/build/release/constantly/staging/apple_mac64">
				constantly.tgz
			</delivery>
		</deliveries>
		<output>
			apple_mac64
		</output>
	</build>
</disclosure>
