	<build suffix="mac64">
		<target>
			apple_mac64
		</target>
		<files>
			<file>
				twisted-twisted-17.9.0.tar.gz
			</file>
			<file>
				README
			</file>
			<file>
				twisted.spec
			</file>
		</files>
		<process>
			<execute>
				tar zxvf twisted-twisted-17.9.0.tar.gz
			</execute>
			<execute>
				cd twisted-twisted-17.9.0
			</execute>
			<execute>
				mkdir -p /tmp/build/release/apple_mac64/twisted/build
			</execute>
			<execute>
				cp -r /tmp/twisted/src/* /tmp/build/release/apple_mac64/twisted/build
			</execute>
			<execute>
				cp -r /tmp/twisted/src/* /tmp/build/release/apple_mac64/twisted/build
			</execute>
			<execute>
				cd /tmp/build/release/apple_mac64/twisted/build
			</execute>
			<execute>
				export OTOOL=/build/toolchain/mac32/xcode-7.3/Xcode.app/Contents/Developer/Toolchains/XcodeDefault.xctoolchain/usr/bin/otool
			</execute>
			<execute>
				export DSYMUTIL=/build/toolchain/mac32/xcode-7.3/Xcode.app/Contents/Developer/Toolchains/XcodeDefault.xctoolchain/usr/bin/dsymutil
			</execute>
			<execute>
				export LDFLAGS=-Wl,-headerpad_max_install_names -arch x86_64 -isysroot /build/toolchain/mac32/xcode-7.3/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX10.11.sdk -mmacosx-version-min=10.9
			</execute>
			<execute>
				export CC=/build/toolchain/mac32/xcode-7.3/Xcode.app/Contents/Developer/Toolchains/XcodeDefault.xctoolchain/usr/bin/clang
			</execute>
			<execute>
				export PYTHONPATH=/tmp/compcache/cayman_setuptools/ob-6883993/macosx-elcapitan/apple_mac64/lib/python3.5/site-packages:/tmp/compcache/cayman_zope_interface/ob-6884002/macosx-elcapitan/apple_mac64/lib/python3.5/site-packages:/tmp/compcache/cayman_six/ob-5693504/linux64/noarch/lib/python3.5/site-packages:/tmp/compcache/cayman_incremental/ob-5830043/windows-2016-vs2015-U3/win64_vc140/Lib/site-packages:/tmp/compcache/cayman_automat/ob-5838235/windows-2016-vs2015-U3/win64_vc140/Lib/site-packages:/tmp/compcache/cayman_constantly/ob-6889393/macosx-elcapitan/apple_mac64/lib/python3.5/site-packages:/tmp/compcache/cayman_python-attrs/ob-5829946/windows-2016-vs2015-U3/win64_vc140/Lib/site-packages:/tmp/compcache/cayman_hyperlink/ob-7514782/linux64/noarch:/tmp/build/release/apple_mac64/twisted/build/dist/lib/python3.5/site-packages
			</execute>
			<execute>
				export MAKE=/build/toolchain/mac32/make-3.82/bin/make
			</execute>
			<execute>
				export LDSHARED=/build/toolchain/mac32/xcode-7.3/Xcode.app/Contents/Developer/Toolchains/XcodeDefault.xctoolchain/usr/bin/clang -Wl,-headerpad_max_install_names -arch x86_64 -isysroot /build/toolchain/mac32/xcode-7.3/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX10.11.sdk -mmacosx-version-min=10.9 -bundle -undefined dynamic_lookup
			</execute>
			<execute>
				export NMEDIT=/build/toolchain/mac32/xcode-7.3/Xcode.app/Contents/Developer/Toolchains/XcodeDefault.xctoolchain/usr/bin/nmedit
			</execute>
			<execute>
				export LIPO=/build/toolchain/mac32/xcode-7.3/Xcode.app/Contents/Developer/Toolchains/XcodeDefault.xctoolchain/usr/bin/lipo
			</execute>
			<execute>
				export DEVELOPER_DIR=/build/toolchain/mac32/xcode-7.3/Xcode.app/Contents/Developer
			</execute>
			<execute>
				export CXX=/build/toolchain/mac32/xcode-7.3/Xcode.app/Contents/Developer/Toolchains/XcodeDefault.xctoolchain/usr/bin/clang++
			</execute>
			<execute>
				export RANLIB=/build/toolchain/mac32/xcode-7.3/Xcode.app/Contents/Developer/Toolchains/XcodeDefault.xctoolchain/usr/bin/ranlib
			</execute>
			<execute>
				export CFLAGS=-g -fPIC -pipe -Wall -arch x86_64 -isysroot /build/toolchain/mac32/xcode-7.3/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX10.11.sdk -mmacosx-version-min=10.9
			</execute>
			<execute>
				export STRIP=/build/toolchain/mac32/xcode-7.3/Xcode.app/Contents/Developer/Toolchains/XcodeDefault.xctoolchain/usr/bin/strip
			</execute>
			<execute>
				export PATH=/tmp/build/release/apple_mac64/twisted/deps/bin:
			</execute>
			<execute>
				export TMPDIR=/build/mts/release/bora-7542210/tmp
			</execute>
			<execute>
				export NM=/build/toolchain/mac32/xcode-7.3/Xcode.app/Contents/Developer/Toolchains/XcodeDefault.xctoolchain/usr/bin/nm
			</execute>
			<execute>
				/build/toolchain/mac32/python-3.5.2-openssl1.0.2k/bin/python3 setup.py build
			</execute>
			<execute>
				mkdir -p /tmp/build/release/apple_mac64/twisted/build/dist/lib/python3.5/site-packages
			</execute>
			<execute>
				/build/toolchain/mac32/python-3.5.2-openssl1.0.2k/bin/python3 setup.py install '--prefix=/tmp/build/release/apple_mac64/twisted/build/dist'
			</execute>
			<execute>
				mkdir -p /build/mts/release/bora-7542210/publish/apple_mac64/twisted.egg
			</execute>
			<execute>
				cp -r /tmp/build/release/apple_mac64/twisted/build/dist/lib/python3.5/site-packages/Twisted-17.9.1.dev0-py3.5-macosx-10.6-intel.egg/* /build/mts/release/bora-7542210/publish/apple_mac64/twisted.egg
			</execute>
		</process>
		<deliveries>
			<delivery dir="/tmp/build/release/twisted/staging/apple_mac64">
				twisted.tgz
			</delivery>
